        "feature",
        "field_binding",
        "hypothesis",
        "idea",
        "insight",
        "integration",
        "interaction",
        "issue",
        "metric",
        "milestone",
        "note",
        "persona",
        "problem",
        "prompt",
        "prompt_block",
        "prompt_flow",
        "prompt_variable",
        "question",
        "requirement",
        "risk",
        "screen",
        "skill",
        "source",
        "task",
        "test_case",
        "threat",
        "tool_definition",
        "ui_state",
        "user_flow",
        "user_story",
        "wireframe_component"
      ],
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "status": {
      "enum": [
        "scratch",
        "proposed",
        "in_review",
        "approved",
        "rejected",
        "deprecated",
        "archived"
      ],
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "visibility": {
      "default": "project",
      "enum": [
        "project",
        "private",
        "restricted"
      ],
      "type": "string"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "secret-bearing"
      ],
      "type": "string",
      "default": "internal"
    },
    "locked_fields": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance": {
      "properties": {
        "origin": {
          "enum": [
            "user_input",
            "prompt_run",
            "import",
            "system",
            "integration"
          ],
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_artifact_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "alias",
    "project_id",
    "type",
    "schema_version",
    "title",
    "payload",
    "status",
    "revision",
