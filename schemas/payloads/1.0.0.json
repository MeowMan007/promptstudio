    "screen": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://promptstudio.app/schemas/payloads/1.0.0/screen.json",
      "title": "screen payload",
      "type": "object",
      "required": [
        "name",
        "route",
        "purpose",
        "regions",
        "elements",
        "states"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "purpose": {
          "type": "string"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "preset": {
              "enum": [
                "desktop",
                "tablet",
                "mobile"
              ]
            },
            "w": {
              "type": "integer"
            },
            "h": {
              "type": "integer"
            }
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "elements"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "component"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "component": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "action": {
                "type": "string"
              },
              "validation": {
                "type": "object"
              }
            }
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "trigger",
              "target",
              "effect"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "trigger": {
                "enum": [
                  "click",
                  "submit",
                  "change",
                  "blur",
                  "key",
                  "route",
                  "async_done"
                ]
              },
              "target": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              },
              "on_success": {
                "type": "object"
              },
              "on_error": {
                "type": "object"
              }
            }
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "empty",
              "loading",
              "populated",
              "editing",
              "invalid",
              "saving",
              "saved",
              "error",
              "permission_denied",
              "offline",
              "success"
            ]
          }
        },
        "responsive": {
          "type": "object"
        },
        "implements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
