    "requirement": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://promptstudio.app/schemas/payloads/1.0.0/requirement.json",
      "type": "object",
      "required": [
        "ears_pattern",
        "clauses",
        "priority",
        "acceptance_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "ears_pattern": {
          "enum": [
            "ubiquitous",
            "event_driven",
            "state_driven",
            "unwanted_behaviour",
            "optional_feature"
          ]
        },
        "clauses": {
          "type": "object",
          "required": [
            "response"
          ],
          "properties": {
            "trigger": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            },
            "feature": {
              "type": "string"
            },
            "system": {
              "type": "string"
            },
            "response": {
              "type": "string",
              "minLength": 5
            }
          }
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could",
            "wont"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "given",
              "when",
              "then"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "given": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "then": {
                "type": "string"
              },
              "measurable_bound": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waiver": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "approver": {
              "type": "string"
            }
          }
        }
      }
    },
    "constraint": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://promptstudio.app/schemas/payloads/1.0.0/constraint.json",
